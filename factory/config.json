{
  "concurrency": 5,
  "max_rounds": 3,
  "base_branch": "main",
  "github": { "issue_label": "factory" },
  "lines": {
    "build": {
      "description": "Turn an accepted topic into working code: spec, build, check, review, merge.",
      "checks": "factory/checks.sh",
      "handoff": "docs"
    },
    "docs": {
      "description": "Bring the documentation in line with what the build line just merged. Change documentation only.",
      "checks": "factory/checks.sh",
      "handoff": null
    }
  },
  "routing": {
    "low":    { "code": "haiku" },
    "medium": { "code": "sonnet" },
    "high":   { "code": "sonnet" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "haiku" },
    "security": { "security": "sonnet" }
  },
  "protected_paths": [
    "factory/checks.sh"
  ],
  "docs_only_paths": [
    "*.md",
    "LICENSE",
    "screenshots/*"
  ],
  "ports": { "base": 5100, "step": 10 },
  "dashboard": { "port": 8000 },
  "prices_usd_per_mtok": {
    "claude-fable-5-2":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 },
    "claude-fable-5":    { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5":     { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5":   { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5":    { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
