#!/usr/bin/env python3
"""Start the factory dashboard in the background, unless it is already running.

Usage: dashboard

Serves factory/ on 127.0.0.1 (this machine only; the folder holds job files)
and prints the dashboard URL. `/factory run` calls this first, so the
dashboard is up the first time anyone uses the factory and is left alone on
every later run. Safe to run any number of times.

The port starts at config.json `dashboard.port` (default 8000). A server on a
port is treated as this factory's own only if it serves the same
factory/.dashboard-id file; otherwise (another project's dashboard, or some
other program) the next port is tried, up to ten.

Never fatal: if it can't start, it says so and exits 0.
"""
import json
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
CONFIG = json.loads((FACTORY / "config.json").read_text(encoding="utf-8"))
BASE_PORT = int(CONFIG.get("dashboard", {}).get("port", 8000))
ID_FILE = FACTORY / ".dashboard-id"
IDENT = str(FACTORY)


def listening(port):
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def is_ours(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/.dashboard-id", timeout=2) as r:
            return r.read().decode("utf-8").strip() == IDENT
    except OSError:
        return False


def start(port):
    ID_FILE.write_text(IDENT + "\n", encoding="utf-8")
    kwargs = {"stdin": subprocess.DEVNULL, "stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL, "cwd": FACTORY}
    if sys.platform == "win32":
        kwargs["creationflags"] = subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True
    subprocess.Popen([sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1"], **kwargs)
    for _ in range(30):
        if is_ours(port):
            return True
        time.sleep(0.1)
    return False


def main():
    for port in range(BASE_PORT, BASE_PORT + 10):
        url = f"http://localhost:{port}/dashboard.html"
        if listening(port):
            if is_ours(port):
                print(f"dashboard: already running at {url}")
                return
            continue  # someone else's server; try the next port
        if start(port):
            print(f"dashboard: started at {url}")
        else:
            print(f"dashboard: couldn't start on port {port}; run `cd factory && python3 -m http.server` yourself",
                  file=sys.stderr)
        return
    print(f"dashboard: ports {BASE_PORT}-{BASE_PORT + 9} are all busy; set dashboard.port in factory/config.json",
          file=sys.stderr)


if __name__ == "__main__":
    main()
