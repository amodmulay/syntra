#!/usr/bin/env python3
"""Maintain the project's token-usage ledger.

Usage:
    factory/bin/usage ingest [TRANSCRIPT_OR_DIR ...]   append new API calls to the ledger
    factory/bin/usage report                           regenerate factory/usage/USAGE.md

With no paths, ingest reads Claude Code transcripts for this repo from
~/.claude/projects/<repo-path-slug>/ (main sessions and subagent sidechains).

The ledger (factory/usage/ledger.jsonl) is append-only, one line per API call,
deduplicated by Anthropic message id, so ingest is safe to re-run. Transcripts
live outside the repo and may be cleaned up, so ingest regularly (e.g. before
each commit) to keep the history.
"""
import collections, json, pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
LEDGER = ROOT / "factory" / "usage" / "ledger.jsonl"
REPORT = ROOT / "factory" / "usage" / "USAGE.md"
FIELDS = ("input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens")


def default_sources():
    slug = re.sub(r"[^A-Za-z0-9]", "-", str(ROOT))
    base = pathlib.Path.home() / ".claude" / "projects" / slug
    return [base] if base.exists() else []


def prices():
    return json.loads((ROOT / "factory" / "config.json").read_text(encoding="utf8")).get("prices_usd_per_mtok", {})


def price_call(model, r, table):
    """API-equivalent dollars for one call, or None when the model has no listed price."""
    p = table.get(model)
    if not p:
        return None
    write_1h = r["cache_write_1h"]
    write_5m = r["cache_creation_input_tokens"] - write_1h
    return round((r["input_tokens"] * p["input"] + r["output_tokens"] * p["output"]
                  + write_5m * p["cache_write_5m"] + write_1h * p["cache_write_1h"]
                  + r["cache_read_input_tokens"] * p["cache_read"]) / 1e6, 6)


def load_ledger():
    """Rows in file order; a duplicated id (concurrent ingests) is counted once."""
    rows, seen = [], set()
    if LEDGER.exists():
        for l in LEDGER.read_text(encoding="utf8").splitlines():
            if l.strip():
                r = json.loads(l)
                if r["id"] not in seen:
                    seen.add(r["id"])
                    rows.append(r)
    return rows


def calls_from(path):
    """Yield one record per API call (message id), taking the last usage seen."""
    seen = {}
    for line in path.open(encoding="utf8", errors="replace"):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        m = d.get("message")
        if d.get("type") != "assistant" or not isinstance(m, dict) or not m.get("usage"):
            continue
        mid = m.get("id")
        if not mid or not m.get("model") or m["model"] == "<synthetic>":
            continue
        u = m["usage"]
        seen[mid] = {
            "id": mid,
            "ts": d.get("timestamp"),
            "model": m["model"],
            "session": d.get("sessionId") or path.stem,
            "sidechain": bool(d.get("isSidechain")),
            **{k: int(u.get(k) or 0) for k in FIELDS},
            "thinking_tokens": int((u.get("output_tokens_details") or {}).get("thinking_tokens") or 0),
            "cache_write_1h": int((u.get("cache_creation") or {}).get("ephemeral_1h_input_tokens") or 0),
        }
    table = prices()
    for r in seen.values():
        # Priced when ingested, so the dollar value survives later price changes.
        r["cost_usd"] = price_call(r["model"], r, table)
    return seen.values()


def ingest(paths):
    paths = [pathlib.Path(p) for p in paths] or default_sources()
    files = []
    for p in paths:
        files += sorted(p.rglob("*.jsonl")) if p.is_dir() else [p]
    rows = load_ledger()
    index = {r["id"]: i for i, r in enumerate(rows)}
    new, filled = [], 0
    for f in files:
        for r in calls_from(f):
            if r["id"] not in index:
                index[r["id"]] = -1  # added in this run, not in `rows`
                new.append(r)
            elif index[r["id"]] >= 0 and "cost_usd" not in rows[index[r["id"]]]:
                # One-time backfill of rows written before dollars were recorded.
                rows[index[r["id"]]] = r
                filled += 1
    new.sort(key=lambda r: r["ts"] or "")
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    if filled:
        LEDGER.write_text("".join(json.dumps(r, sort_keys=True) + "\n" for r in rows), encoding="utf8", newline="\n")
    with LEDGER.open("a", encoding="utf8", newline="\n") as fh:
        for r in new:
            fh.write(json.dumps(r, sort_keys=True) + "\n")
    print(f"scanned {len(files)} transcript(s); added {len(new)} new call(s), backfilled {filled}")
    report()


def report():
    rows = load_ledger()
    by = collections.defaultdict(lambda: collections.Counter())
    for r in rows:
        c = by[r["model"]]
        c["calls"] += 1
        for k in FIELDS + ("thinking_tokens",):
            c[k] += r[k]
        c["usd"] += r.get("cost_usd") or 0
        c["unpriced"] += r.get("cost_usd") is None
    out =["# Token usage log", "",
           "Generated by `factory/bin/usage report` from `factory/usage/ledger.jsonl`",
           "(append-only, one line per API call). Do not edit by hand.", ""]
    if rows:
        ts = sorted(r["ts"] for r in rows if r["ts"])
        out += [f"Covers {ts[0]} to {ts[-1]} (UTC), {len(rows)} API call(s).", ""]
    out += ["| Model | Calls | Input | Output (of which thinking) | Cache write | Cache read | API-equivalent USD |",
            "|---|---:|---:|---:|---:|---:|---:|"]
    tot = collections.Counter()
    for model, c in sorted(by.items()):
        out.append(f"| {model} | {c['calls']:,} | {c['input_tokens']:,} | {c['output_tokens']:,} "
                   f"({c['thinking_tokens']:,}) | {c['cache_creation_input_tokens']:,} | {c['cache_read_input_tokens']:,} "
                   f"| ${c['usd']:,.4f} |")
        tot.update(c)
    out.append(f"| **Total** | {tot['calls']:,} | {tot['input_tokens']:,} | {tot['output_tokens']:,} "
               f"({tot['thinking_tokens']:,}) | {tot['cache_creation_input_tokens']:,} | {tot['cache_read_input_tokens']:,} "
               f"| ${tot['usd']:,.4f} |")
    if tot["unpriced"]:
        out += ["", f"{tot['unpriced']} call(s) use a model with no price in `factory/config.json` and count as $0."]
    days = collections.defaultdict(collections.Counter)
    for r in rows:
        d = days[((r["ts"] or "")[:10], r["model"])]
        d["calls"] += 1
        d["tok"] += sum(r[k] for k in FIELDS)
        d["usd"] += r.get("cost_usd") or 0
    out += ["", "## By day", "", "| Date | Model | Calls | All tokens | USD |", "|---|---|---:|---:|---:|"]
    for (day, model), c in sorted(days.items()):
        out.append(f"| {day} | {model} | {c['calls']:,} | {c['tok']:,} | ${c['usd']:,.4f} |")
    out += ["", "## Limits", "",
            "- Only usage recorded in Claude Code transcripts available when `ingest` was run is included.",
            "  Work done before the ledger was started, in other tools, or in transcripts since deleted is not captured.",
            "- Codex model/token usage is not exposed by the tools available in this workspace and is not captured.",
            "- Re-run `factory/bin/usage ingest` regularly; transcripts live outside the repo."]
    REPORT.write_text("\n".join(out) + "\n", encoding="utf8", newline="\n")
    print(f"wrote {REPORT.relative_to(ROOT)}")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "report"
    if cmd == "ingest":
        ingest(sys.argv[2:])
    elif cmd == "report":
        report()
    else:
        sys.exit(__doc__)
