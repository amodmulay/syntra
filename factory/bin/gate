#!/usr/bin/env python3
"""The one deterministic checkpoint: does this branch pass its line's checks?

Usage:
  gate <job-id>            write <pass>/round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as merge-checks.md (job merge runs it)
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

This always executes the main checkout's own copy of the line's check script,
run inside the job's worktree — so a branch can never rewrite the checks it
gets judged against. It also fails outright if the branch modified or deleted
a file matching config.json's `protected_paths` (fnmatch patterns, with `*`
matching `/` too). New files are unaffected.
"""

import fnmatch
import shutil
import functools
import json
import pathlib
import re
import subprocess
import sys
import time
from pathlib import Path

# Windows defaults to a legacy code page; every file the factory touches is UTF-8.
pathlib.Path.read_text = functools.partialmethod(pathlib.Path.read_text, encoding="utf-8")
pathlib.Path.write_text = functools.partialmethod(pathlib.Path.write_text, encoding="utf-8")

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
BASE = CONFIG["base_branch"]
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True, encoding="utf-8", errors="replace")
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def load_job(job_id):
    return json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())


# Same resolution as factory/bin/job's worktree_path (a parity test keeps them in step).
ID_RE = r"[0-9]{3,}-[a-z0-9][a-z0-9-]*"


def worktree_path(job):
    """Where git and checks run: REPO/.worktrees/<id>. The stored job["worktree"] is
    never used, and REPO is never a fallback. Read-only. Refusal exits 2."""
    stored = job.get("worktree")
    job_id = job.get("id")
    if not isinstance(job_id, str) or not re.fullmatch(ID_RE, job_id):
        die(f"job id {job_id!r} isn't a valid job id")
    root = REPO / ".worktrees"
    path = root / job_id
    if path.resolve() != root.resolve() / job_id:  # refuses a symlink at the id
        die(f"{job_id}: worktree path escapes {root}")
    if not path.is_dir():
        die(f"{job_id}: no worktree at {path} (job.json has {stored!r}). "
            "Create it on this machine or run the step where the worktree exists.")
    return str(path)


def checks_script(job):
    line = CONFIG["lines"][job["line"]]
    return REPO / line["checks"]


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"{BASE}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree, script):
    start = time.monotonic()
    res = subprocess.run([shutil.which("bash") or "bash", Path(script).as_posix()], cwd=worktree, capture_output=True, text=True, encoding="utf-8", errors="replace")
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge):
    job = load_job(job_id)
    worktree = worktree_path(job)
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    pass_dir = FACTORY / "jobs" / job_id / f"{job['pass']:02d}-{job['line']}"
    round_dir = pass_dir / f"round-{job['round']}"
    script = checks_script(job)
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    code, log, seconds = run_checks(worktree, script)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    round_dir.mkdir(parents=True, exist_ok=True)
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"{script.relative_to(REPO)} {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (f", synced with the latest {BASE} before merging" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## {script.name}\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({job_id} {job['line']} round {job['round']}, exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser(), encoding="utf-8", errors="replace") as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job = load_job(job_id)
    code, log, _ = run_checks(worktree_path(job), checks_script(job))
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"this line's checks fail in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
